# Copy this file to .env and fill in your own values. .env is gitignored.

POSTGRES_DB=artist_activity
POSTGRES_USER=artist_activity
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Get a key at https://developer.ticketmaster.com/ (free tier is enough
# for this seed list; see README for the rate limit it grants you).
TICKETMASTER_API_KEY=

# MusicBrainz asks every API consumer to identify themselves with a
# descriptive User-Agent including real contact info -- put your own
# email or project URL in here, not a placeholder, or MusicBrainz may
# throttle/block requests with no way to reach you about it.
# Format: "AppName/Version ( contact )"
MUSICBRAINZ_USER_AGENT=ArtistActivityDataLayer/0.1 ( your-email@example.com )
